# Copy this file to a private, Git-ignored environment file on the server.
# Full Git commit SHA used as the immutable backend and web image tag.
APP_VERSION=

# Generate on the server with: openssl rand -hex 32
DB_PASSWORD=

# DuckDNS hostname only, without https:// or a trailing slash.
SITE_DOMAIN=

# Keep the public portfolio deployment in deterministic mock mode.
LLM_MODE=mock
